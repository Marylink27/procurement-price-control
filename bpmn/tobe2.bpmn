<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ToBe2" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_ToBe2"><bpmn:participant id="Pool_ToBe2" name="TO BE 2: проверка, согласование и выгрузка в 1С" processRef="ToBe2"/></bpmn:collaboration>
<bpmn:process id="ToBe2" isExecutable="false">
<bpmn:laneSet id="LS_ToBe2">
<bpmn:lane id="L_sys" name="Портал закупок">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_buy" name="Закупщик">
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_head" name="Руководитель направления">
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_1c" name="1С">
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Предложения готовы к проверке"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="g1" name="Отклонение выше порога?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t1" name="Проверить предложение, указать причину"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g2" name="Принять?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t2" name="Отклонить и вернуть поставщику с комментарием"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e2" name="Предложение отклонено"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t3" name="Согласовать рост цены"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g3" name="Согласовано?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t4" name="Сформировать пакет цен для 1С"><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t5" name="Загрузить закупочные цены, вернуть результат"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t6" name="Зафиксировать результат и историю цены"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e1" name="Цены в 1С актуальны"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s" targetRef="g1"/>
<bpmn:sequenceFlow id="f2" name="да" sourceRef="g1" targetRef="t1"/>
<bpmn:sequenceFlow id="f3" name="нет" sourceRef="g1" targetRef="t4"/>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t1" targetRef="g2"/>
<bpmn:sequenceFlow id="f5" name="нет" sourceRef="g2" targetRef="t2"/>
<bpmn:sequenceFlow id="f6" name="" sourceRef="t2" targetRef="e2"/>
<bpmn:sequenceFlow id="f7" name="да" sourceRef="g2" targetRef="t3"/>
<bpmn:sequenceFlow id="f8" name="" sourceRef="t3" targetRef="g3"/>
<bpmn:sequenceFlow id="f9" name="нет" sourceRef="g3" targetRef="t2"/>
<bpmn:sequenceFlow id="f10" name="да" sourceRef="g3" targetRef="t4"/>
<bpmn:sequenceFlow id="f11" name="" sourceRef="t4" targetRef="t5"/>
<bpmn:sequenceFlow id="f12" name="" sourceRef="t5" targetRef="t6"/>
<bpmn:sequenceFlow id="f13" name="" sourceRef="t6" targetRef="e1"/>
</bpmn:process>
