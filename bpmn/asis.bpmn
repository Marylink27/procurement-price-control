<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_AsIs" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_AsIs"><bpmn:participant id="Pool_AsIs" name="AS IS: обновление закупочных цен вручную" processRef="AsIs"/></bpmn:collaboration>
<bpmn:process id="AsIs" isExecutable="false">
<bpmn:laneSet id="LS_AsIs">
<bpmn:lane id="L_sup" name="Поставщик">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_buy" name="Закупщик">
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_head" name="Руководитель направления">
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_1c" name="1С">
<bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Цены поставщика изменились"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="t1" name="Отправить прайс-лист по почте (Excel, свой формат)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:sendTask>
<bpmn:manualTask id="t2" name="Найти письмо и скачать прайс"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t3" name="Найти позиции в каталоге вручную по названию и ШК"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t4" name="Сравнить с ценой из выгрузки 1С через ВПР"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="g1" name="Цена выросла?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="t5" name="Согласовать в мессенджере или по почте"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="g2" name="Согласовано?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e2" name="Переговоры с поставщиком"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent>
<bpmn:manualTask id="t6" name="Внести новые цены в 1С вручную"><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:manualTask>
<bpmn:task id="t7" name="Закупочная цена обновлена"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e1" name="Цены обновлены"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s" targetRef="t1"/>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="t3"/>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t3" targetRef="t4"/>
<bpmn:sequenceFlow id="f5" name="" sourceRef="t4" targetRef="g1"/>
<bpmn:sequenceFlow id="f6" name="да" sourceRef="g1" targetRef="t5"/>
<bpmn:sequenceFlow id="f7" name="нет" sourceRef="g1" targetRef="t6"/>
<bpmn:sequenceFlow id="f8" name="" sourceRef="t5" targetRef="g2"/>
<bpmn:sequenceFlow id="f9" name="да" sourceRef="g2" targetRef="t6"/>
<bpmn:sequenceFlow id="f10" name="нет" sourceRef="g2" targetRef="e2"/>
<bpmn:sequenceFlow id="f11" name="" sourceRef="t6" targetRef="t7"/>
<bpmn:sequenceFlow id="f12" name="" sourceRef="t7" targetRef="e1"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="D_AsIs"><bpmndi:BPMNPlane id="P_AsIs" bpmnElement="Collab_AsIs">
<bpmndi:BPMNShape id="Pool_AsIs_di" bpmnElement="Pool_AsIs" isHorizontal="true"><dc:Bounds x="60" y="40" width="2170" height="600"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_sup_di" bpmnElement="L_sup" isHorizontal="true"><dc:Bounds x="90" y="40" width="2140" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_buy_di" bpmnElement="L_buy" isHorizontal="true"><dc:Bounds x="90" y="190" width="2140" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_head_di" bpmnElement="L_head" isHorizontal="true"><dc:Bounds x="90" y="340" width="2140" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_1c_di" bpmnElement="L_1c" isHorizontal="true"><dc:Bounds x="90" y="490" width="2140" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="197.0" y="97.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="160.0" y="137.0" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="330.0" y="75.0" width="150" height="80"/></bpmndi:BPMNShape>
