<bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="710.0" y="75.0" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="900.0" y="225.0" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1140.0" y="240.0" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1110.0" y="206.0" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1280.0" y="375.0" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1470.0" y="225.0" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1717.0" y="247.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1680.0" y="287.0" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="233.0" y="115.0"/><di:waypoint x="330.0" y="115.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="480.0" y="115.0"/><di:waypoint x="500.0" y="115.0"/><di:waypoint x="500.0" y="265.0"/><di:waypoint x="520.0" y="265.0"/></bpmndi:BPMNEdge>
