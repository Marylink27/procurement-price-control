<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="785.0" y="240.0"/><di:waypoint x="785.0" y="155.0"/><bpmndi:BPMNLabel><dc:Bounds x="793.0" y="214.0" width="40" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="785.0" y="75.0"/><di:waypoint x="785.0" y="57.0"/><di:waypoint x="405.0" y="57.0"/><di:waypoint x="405.0" y="75.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="810.0" y="265.0"/><di:waypoint x="900.0" y="265.0"/><bpmndi:BPMNLabel><dc:Bounds x="818.0" y="245.0" width="40" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
