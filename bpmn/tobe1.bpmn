<bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="330.0" y="75.0" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="520.0" y="225.0" width="150" height="80"/></bpmndi:BPMNShape>
