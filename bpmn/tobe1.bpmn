<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ToBe1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_ToBe1"><bpmn:participant id="Pool_ToBe1" name="TO BE 1: приём прайс-листа и сопоставление" processRef="ToBe1"/></bpmn:collaboration>
<bpmn:process id="ToBe1" isExecutable="false">
<bpmn:laneSet id="LS_ToBe1">
<bpmn:lane id="L_sup" name="Поставщик">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_sys" name="Портал закупок">
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_buy" name="Закупщик">
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Цены поставщика изменились"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="t1" name="Загрузить прайс в портал или на почту импорта"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:sendTask>
<bpmn:serviceTask id="t2" name="Импортировать файл по шаблону источника, проверить"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="Файл корректен?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:receiveTask id="t3" name="Исправить файл по отчёту об ошибках"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:receiveTask>
<bpmn:serviceTask id="t4" name="Сопоставить автоматически: ШК, артикул, название"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g2" name="Остались позиции без пары?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t5" name="Сопоставить вручную, сохранить правило"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t6" name="Рассчитать отклонение от текущей закупочной цены"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e1" name="Предложения готовы к проверке"><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s" targetRef="t1"/>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="g1"/>
<bpmn:sequenceFlow id="f4" name="нет" sourceRef="g1" targetRef="t3"/>
<bpmn:sequenceFlow id="f5" name="" sourceRef="t3" targetRef="t1"/>
<bpmn:sequenceFlow id="f6" name="да" sourceRef="g1" targetRef="t4"/>
<bpmn:sequenceFlow id="f7" name="" sourceRef="t4" targetRef="g2"/>
<bpmn:sequenceFlow id="f8" name="да" sourceRef="g2" targetRef="t5"/>
<bpmn:sequenceFlow id="f9" name="нет" sourceRef="g2" targetRef="t6"/>
<bpmn:sequenceFlow id="f10" name="" sourceRef="t5" targetRef="t6"/>
<bpmn:sequenceFlow id="f11" name="" sourceRef="t6" targetRef="e1"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="D_ToBe1"><bpmndi:BPMNPlane id="P_ToBe1" bpmnElement="Collab_ToBe1">
<bpmndi:BPMNShape id="Pool_ToBe1_di" bpmnElement="Pool_ToBe1" isHorizontal="true"><dc:Bounds x="60" y="40" width="1790" height="450"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_sup_di" bpmnElement="L_sup" isHorizontal="true"><dc:Bounds x="90" y="40" width="1760" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_sys_di" bpmnElement="L_sys" isHorizontal="true"><dc:Bounds x="90" y="190" width="1760" height="150"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L_buy_di" bpmnElement="L_buy" isHorizontal="true"><dc:Bounds x="90" y="340" width="1760" height="150"/></bpmndi:BPMNShape>
